<%- include('partials/head', { title: 'Betalfiler' }) %>
<%- include('partials/shell-top') %>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="page-title">Betalfiler</h1>
    <p class="page-subtitle">Filer i formatet pain.001 som importeras i Nordea Business för att betala flera fakturor på en gång.</p>
  </div>
  <a href="/payment-files/create" class="btn btn-primary"><span class="icon">add</span>Skapa betalfil</a>
</div>

<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead class="border-b border-line bg-surface-low">
        <tr>
          <th class="th">Skapad</th>
          <th class="th">Filnamn</th>
          <th class="th text-right">Betalningar</th>
          <th class="th text-right">Totalbelopp</th>
          <th class="th">Betaldatum</th>
          <th class="th w-12"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% if (files.length === 0) { %>
          <tr>
            <td colspan="6" class="px-6 py-16 text-center">
              <span class="icon icon-xl mb-3 block text-ink-faint/60">payments</span>
              <p class="font-display font-bold">Inga betalfiler ännu</p>
              <p class="mx-auto mt-1 max-w-md text-sm text-ink-muted">Godkänn de fakturor som ska betalas, skapa sedan en betalfil och importera den i Nordea.</p>
              <a href="/payment-files/create" class="btn btn-secondary mt-5"><span class="icon">add</span>Skapa betalfil</a>
            </td>
          </tr>
        <% } %>
        <% files.forEach(function (f) { %>
          <tr class="hover:bg-surface-low">
            <td class="td whitespace-nowrap text-ink-muted"><%= h.date(f.created_at) %></td>
            <td class="td font-mono text-[13px]"><%= f.filename %></td>
            <td class="td text-right tabular-nums"><%= f.num_transactions %></td>
            <td class="td whitespace-nowrap text-right font-semibold tabular-nums"><%= h.money(f.total_amount, f.currency) %></td>
            <td class="td whitespace-nowrap"><%= f.execution_date %></td>
            <td class="td text-center">
              <a href="/payment-files/<%= f.id %>/download" class="inline-flex rounded p-1 text-ink-faint hover:bg-surface-mid hover:text-primary" title="Ladda ner XML" aria-label="Ladda ner <%= f.filename %>"><span class="icon">download</span></a>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<%- include('partials/shell-bottom') %>
