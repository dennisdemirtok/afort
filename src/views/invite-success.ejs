<%- include('partials/head', { title: mode === 'reset' ? 'Nytt lösenord' : 'Användare inbjuden' }) %>
<%- include('partials/shell-top') %>

<div class="mx-auto max-w-lg">
  <div class="card p-8 text-center">
    <span class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-full bg-emerald-100"><span class="icon icon-lg text-emerald-700">check</span></span>
    <h1 class="text-2xl font-extrabold tracking-tight"><%= mode === 'reset' ? 'Nytt lösenord skapat' : user.name + ' är inbjuden' %></h1>
    <p class="mt-2 text-sm text-ink-muted">Skicka uppgifterna nedan till <%= user.name %>. Lösenordet visas bara den här gången.</p>

    <div class="mt-6 space-y-3 rounded-lg bg-surface-low p-4 text-left">
      <div>
        <span class="label mb-0.5">Adress</span>
        <p class="break-all font-mono text-sm" id="login-url"><%= loginUrl %></p>
      </div>
      <div>
        <span class="label mb-0.5">E-post</span>
        <p class="break-all font-mono text-sm" id="login-email"><%= user.email %></p>
      </div>
      <div>
        <span class="label mb-0.5">Tillfälligt lösenord</span>
        <p class="font-mono text-sm" id="temp-password"><%= tempPassword %></p>
      </div>
    </div>

    <button type="button" id="copy-button" class="btn btn-primary mt-5 w-full"><span class="icon">content_copy</span><span data-label>Kopiera allt</span></button>
    <p class="mt-4 text-xs text-ink-muted">Användaren byter själv lösenord under sitt konto (namnet längst ner i menyn) efter första inloggningen.</p>
    <a href="/settings" class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:underline"><span class="icon icon-sm">arrow_back</span>Tillbaka till inställningar</a>
  </div>
</div>

<script>
  document.getElementById('copy-button').addEventListener('click', function () {
    var button = this, label = button.querySelector('[data-label]');
    var get = function (id) { return document.getElementById(id).textContent; };
    var text = 'AFORT – inloggning
Adress: ' + get('login-url') + '
E-post: ' + get('login-email') + '
Lösenord: ' + get('temp-password');
    navigator.clipboard.writeText(text).then(function () {
      label.textContent = 'Kopierat!';
      setTimeout(function () { label.textContent = 'Kopiera allt'; }, 2000);
    });
  });
</script>
<%- include('partials/shell-bottom') %>
