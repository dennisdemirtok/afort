<%- include('partials/head', { title: 'Inställningar' }) %>
<%- include('partials/shell-top') %>

<div class="mb-8">
  <h1 class="page-title">Inställningar</h1>
  <p class="page-subtitle">Användare, vilka avsändare som hämtas in och underhåll.</p>
</div>

<div class="grid max-w-5xl grid-cols-1 gap-6">

  <!-- Gmail -->
  <section class="card p-6">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="section-title"><span class="icon text-primary">mail</span>Gmail-koppling</h2>
        <% if (gmailConfigured) { %>
          <p class="mt-2 flex items-center gap-2 text-sm"><span class="badge badge-paid"><span class="icon icon-sm">check</span>Ansluten</span><span class="text-ink-muted"><%= gmailUser || 'Gmail-konto' %> · kontrolleras var 15:e minut</span></p>
        <% } else { %>
          <p class="mt-2 flex items-center gap-2 text-sm"><span class="badge badge-overdue"><span class="icon icon-sm">error</span>Inte ansluten</span><span class="text-ink-muted">Automatisk hämtning är avstängd.</span></p>
        <% } %>
        <% if (pollStatus.error) { %><p class="mt-2 text-sm text-red-700">Senaste hämtningen gav fel: <%= pollStatus.error %></p><% } %>
        <% if (pollStatus.finishedAt && !pollStatus.running) { %><p class="mt-1 text-xs text-ink-faint">Senast kontrollerad <%= new Date(pollStatus.finishedAt).toLocaleString('sv-SE', { timeZone: 'Europe/Stockholm' }) %></p><% } %>
      </div>
      <a href="/auth/google" class="btn btn-secondary"><span class="icon">link</span><%= gmailConfigured ? 'Anslut om' : 'Anslut Gmail' %></a>
    </div>
  </section>

  <!-- Users -->
  <section class="card p-6">
    <h2 class="section-title"><span class="icon text-primary">group</span>Användare</h2>
    <p class="mt-1 text-sm text-ink-muted">Bokförare kan se fakturor, ladda ner PDF:er, ändra status och läsa in bankutdrag. Bara administratörer kan radera fakturor och ändra inställningar.</p>

    <ul class="mt-5 divide-y divide-line rounded-lg border border-line">
      <% users.forEach(function (u) { %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="flex min-w-0 items-center gap-3">
            <span class="avatar rounded-full"><%= h.initials(u.name) %></span>
            <div class="min-w-0">
              <p class="truncate text-sm font-semibold"><%= u.name %><% if (u.id === user.id) { %> <span class="font-normal text-ink-faint">(du)</span><% } %></p>
              <p class="truncate text-xs text-ink-muted"><%= u.email %> · <%= h.roleLabel(u.role) %></p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <form method="POST" action="/settings/users/<%= u.id %>/reset-password" data-confirm="Skapa ett nytt tillfälligt lösenord för <%= u.name %>? Det gamla slutar fungera direkt.">
              <button type="submit" class="btn btn-ghost btn-sm"><span class="icon icon-sm">key</span>Nytt lösenord</button>
            </form>
            <% if (u.role !== 'admin' || (u.id !== user.id && u.email !== 'admin@afort.local')) { %>
              <form method="POST" action="/settings/users/<%= u.id %>/remove" data-confirm="Ta bort <%= u.name %>? Personen kan inte längre logga in.">
                <button type="submit" class="btn btn-ghost btn-sm text-red-600 hover:bg-red-50 hover:text-red-700"><span class="icon icon-sm">person_remove</span>Ta bort</button>
              </form>
            <% } %>
          </div>
        </li>
      <% }); %>
    </ul>

    <form method="POST" action="/settings/users/invite" class="mt-6 border-t border-line pt-5">
      <h3 class="mb-3 text-sm font-bold">Bjud in en ny användare</h3>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-[1fr_1fr_auto_auto]">
        <div><label class="sr-only" for="invite-name">Namn</label><input class="input" type="text" id="invite-name" name="name" placeholder="Namn" required autocomplete="off"/></div>
        <div><label class="sr-only" for="invite-email">E-post</label><input class="input" type="email" id="invite-email" name="email" placeholder="E-post" required autocomplete="off"/></div>
        <div><label class="sr-only" for="invite-role">Roll</label>
          <select class="input pr-9" id="invite-role" name="role"><option value="viewer">Bokförare</option><option value="admin">Administratör</option></select>
        </div>
        <button type="submit" class="btn btn-primary"><span class="icon">person_add</span>Bjud in</button>
      </div>
      <p class="hint">Du får ett tillfälligt lösenord att skicka vidare. Användaren byter det själv under sitt konto.</p>
    </form>
  </section>

  <!-- Senders -->
  <section class="card p-6">
    <h2 class="section-title"><span class="icon text-primary">forward_to_inbox</span>Avsändare som hämtas in</h2>
    <p class="mt-1 text-sm text-ink-muted">Mail från dessa adresser med en PDF bifogad blir fakturor i AFORT. Ämnesraden måste handla om en faktura (t.ex. innehålla ”Faktura” eller ”Invoice”). Påminnelser blir notiser, och pro forma från Feelgood hoppas över – slutfakturan (FD …) hämtas när den kommer.</p>

    <ul class="mt-5 divide-y divide-line rounded-lg border border-line">
      <% if (rules.length === 0) { %><li class="px-4 py-6 text-center text-sm text-ink-muted">Inga avsändare ännu – lägg till den första nedan.</li><% } %>
      <% rules.forEach(function (r) { %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold"><%= r.vendor_name || 'Namn tas från mailet' %></p>
            <p class="truncate font-mono text-xs text-ink-muted"><%= r.from_address %><% if (r.subject_contains) { %> <span class="font-sans">· ämnet innehåller ”<%= r.subject_contains %>”</span><% } %></p>
          </div>
          <form method="POST" action="/settings/rules/<%= r.id %>/remove" data-confirm="Sluta hämta fakturor från <%= r.from_address %>? Redan hämtade fakturor ligger kvar.">
            <button type="submit" class="btn btn-ghost btn-sm text-red-600 hover:bg-red-50 hover:text-red-700"><span class="icon icon-sm">delete</span>Ta bort</button>
          </form>
        </li>
      <% }); %>
    </ul>

    <form method="POST" action="/settings/rules/add" class="mt-6 border-t border-line pt-5">
      <h3 class="mb-3 text-sm font-bold">Lägg till avsändare</h3>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-[1.2fr_1fr_1fr_auto]">
        <div><label class="sr-only" for="rule-from">Avsändarens e-post</label><input class="input" type="text" id="rule-from" name="from" placeholder="faktura@leverantor.se" required autocomplete="off" inputmode="email"/></div>
        <div><label class="sr-only" for="rule-vendor">Leverantörens namn</label><input class="input" type="text" id="rule-vendor" name="vendor_name" placeholder="Leverantörens namn" autocomplete="off"/></div>
        <div><label class="sr-only" for="rule-subject">Ämnet innehåller</label><input class="input" type="text" id="rule-subject" name="subject_contains" placeholder="Ämnet innehåller (valfritt)" autocomplete="off"/></div>
        <button type="submit" class="btn btn-primary"><span class="icon">add</span>Lägg till</button>
      </div>
      <p class="hint">Skriv <span class="font-mono">@leverantor.se</span> för att ta med alla adresser på en domän.</p>
    </form>
  </section>

  <!-- Receipt senders -->
  <section class="card p-6">
    <h2 class="section-title"><span class="icon text-primary">receipt</span>Kvitton som hämtas in</h2>
    <p class="mt-1 text-sm text-ink-muted">Kortbetalningar (Distribold, Google, Meta …) där mailet eller den bifogade PDF:en är kvittot. De hamnar under <a href="/receipts" class="font-semibold text-primary hover:underline">Kvitton</a>, inte bland fakturorna.</p>

    <ul class="mt-5 divide-y divide-line rounded-lg border border-line">
      <% if (receiptRules.length === 0) { %><li class="px-4 py-6 text-center text-sm text-ink-muted">Inga kvittoavsändare ännu.</li><% } %>
      <% receiptRules.forEach(function (r) { %>
        <li class="flex flex-wrap items-center justify-between gap-3 px-4 py-3">
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold"><%= r.vendor_name || 'Namn tas från mailet' %></p>
            <p class="truncate font-mono text-xs text-ink-muted"><%= r.from_address %><% if (r.subject_contains) { %> <span class="font-sans">· ämnet innehåller ”<%= r.subject_contains %>”</span><% } %></p>
          </div>
          <form method="POST" action="/settings/rules/<%= r.id %>/remove" data-confirm="Sluta hämta kvitton från <%= r.from_address %>? Redan hämtade kvitton ligger kvar.">
            <button type="submit" class="btn btn-ghost btn-sm text-red-600 hover:bg-red-50 hover:text-red-700"><span class="icon icon-sm">delete</span>Ta bort</button>
          </form>
        </li>
      <% }); %>
    </ul>

    <form method="POST" action="/settings/rules/add" class="mt-6 border-t border-line pt-5">
      <input type="hidden" name="kind" value="receipt"/>
      <h3 class="mb-3 text-sm font-bold">Lägg till kvittoavsändare</h3>
      <div class="grid grid-cols-1 gap-3 md:grid-cols-[1.2fr_1fr_1fr_auto]">
        <div><label class="sr-only" for="receipt-from">Avsändarens e-post</label><input class="input" type="text" id="receipt-from" name="from" placeholder="receipts@tjanst.com" required autocomplete="off" inputmode="email"/></div>
        <div><label class="sr-only" for="receipt-vendor">Källans namn</label><input class="input" type="text" id="receipt-vendor" name="vendor_name" placeholder="Källans namn (t.ex. Google Ads)" autocomplete="off"/></div>
        <div><label class="sr-only" for="receipt-subject">Ämnet innehåller</label><input class="input" type="text" id="receipt-subject" name="subject_contains" placeholder="Ämnet innehåller (valfritt)" autocomplete="off"/></div>
        <button type="submit" class="btn btn-primary"><span class="icon">add</span>Lägg till</button>
      </div>
    </form>
  </section>

  <!-- Maintenance -->
  <section class="card p-6">
    <h2 class="section-title"><span class="icon text-primary">build</span>Underhåll</h2>

    <div class="mt-5 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-line px-4 py-4">
      <div class="max-w-xl">
        <p class="text-sm font-semibold">Möjliga dubbletter <span class="badge <%= duplicateCount ? 'badge-approved' : 'badge-neutral' %> ml-1"><%= duplicateCount %></span></p>
        <p class="mt-1 text-sm text-ink-muted">Samma leverantör, fakturanummer och belopp flera gånger – oftast påminnelser eller vidarebefordrade mail. Du granskar och raderar dem själv i fakturalistan.</p>
      </div>
      <a href="/invoices?duplicates=1" class="btn btn-secondary <%= duplicateCount ? '' : 'pointer-events-none opacity-50' %>"><span class="icon">content_copy</span>Granska dubbletter</a>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-4 rounded-lg border border-line px-4 py-4">
      <div class="max-w-xl">
        <p class="text-sm font-semibold">Läs om alla fakturor från Gmail</p>
        <p class="mt-1 text-sm text-ink-muted">Tolkar om belopp, fakturanummer och datum för alla mail. Status, betalmarkeringar, egna ändringar och raderade fakturor påverkas inte. Tar några minuter och körs i bakgrunden.</p>
        <p id="reprocess-status" class="mt-2 hidden text-sm font-medium text-primary" aria-live="polite"></p>
      </div>
      <button type="button" id="reprocess-button" class="btn btn-secondary" onclick="startReprocess()" <%= gmailConfigured ? '' : 'disabled' %>><span class="icon">restart_alt</span>Läs om</button>
    </div>
  </section>
</div>

<script>
  var reprocessTimer = null;

  function showReprocess(status) {
    var el = document.getElementById('reprocess-status');
    var button = document.getElementById('reprocess-button');
    if (status.running && status.mode === 'all') {
      el.classList.remove('hidden');
      el.textContent = 'Läser om… ' + status.done + ' av ' + (status.total || '?') + ' mail';
      button.disabled = true;
      if (!reprocessTimer) reprocessTimer = setInterval(pollReprocess, 2500);
    } else {
      if (reprocessTimer) {
        clearInterval(reprocessTimer);
        reprocessTimer = null;
        el.textContent = status.error
          ? 'Avbröts: ' + status.error
          : 'Klart: ' + status.created + ' nya, ' + status.updated + ' uppdaterade' + (status.failed ? ', ' + status.failed + ' misslyckades' : '') + '.';
      }
      button.disabled = <%= gmailConfigured ? 'false' : 'true' %>;
    }
  }

  function pollReprocess() {
    fetch('/api/reprocess', { credentials: 'same-origin' }).then(function (r) { return r.json(); }).then(showReprocess).catch(function () {});
  }

  function startReprocess() {
    if (!confirm('Läsa om alla fakturor från Gmail? Det tar några minuter.')) return;
    fetch('/api/reprocess', { method: 'POST', credentials: 'same-origin' })
      .then(function (r) { return r.json().then(function (b) { if (!r.ok) throw new Error(b.error || 'Kunde inte starta'); }); })
      .then(function () { showReprocess({ running: true, mode: 'all', done: 0, total: 0 }); })
      .catch(function (err) { alert(err.message); });
  }

  showReprocess(<%- JSON.stringify(pollStatus).replace(/</g, '\\u003c') %>);
</script>
<%- include('partials/shell-bottom') %>
