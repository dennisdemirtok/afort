<%- include('partials/head', { title: 'Bankutdrag' }) %>
<%- include('partials/shell-top') %>

<div class="mb-8">
  <h1 class="page-title">Bankutdrag</h1>
  <p class="page-subtitle">Ladda upp kontoutdraget från Nordea som CSV, så bockas betalda fakturor av med hjälp av fakturanumret i betalningens meddelande, Shopify-utbetalningar med hjälp av beloppet – och kortköp kopplas till sina kvitton med beloppet i SEK.</p>
</div>

<form method="POST" action="/bank-upload" enctype="multipart/form-data" class="card mb-8 p-6">
  <label class="label" for="csvfile">Kontoutdrag (CSV)</label>
  <div class="flex flex-col gap-3 sm:flex-row">
    <input type="file" name="csvfile" id="csvfile" accept=".csv,text/csv" required
           class="input flex-grow cursor-pointer p-1.5 file:mr-4 file:cursor-pointer file:rounded-md file:border-0 file:bg-primary-soft file:px-4 file:py-2 file:text-sm file:font-semibold file:text-primary hover:file:bg-primary/20"/>
    <button type="submit" class="btn btn-primary"><span class="icon">upload_file</span>Ladda upp och matcha</button>
  </div>
  <p class="hint">I Nordea Business: Konton → välj konto → Exportera → CSV. Inget sparas förrän du bekräftar i nästa steg.</p>
</form>

<% if (result) { %>
  <p class="mb-4 text-sm text-ink-muted">
    <span class="font-semibold text-ink"><%= result.filename %></span> ·
    <%= result.payments %> utgående betalningar ·
    <%= result.toMark.length %> att bocka av ·
    <%= result.alreadyPaid.length %> redan betalda ·
    <%= result.unmatched.length %> utan matchning<% if (result.payouts.length) { %> ·
    <%= result.payouts.length %> Shopify-utbetalningar<% } %><% if (result.receiptMatches.length || result.cardsWithoutReceipt.length) { %> ·
    <%= result.receiptMatches.length + result.cardsWithoutReceipt.length %> kortköp<% } %>
  </p>

  <form method="POST" action="/bank-upload/apply" id="apply-form">
  <% if (result.receiptMatches.length) { %>
    <div class="card mb-8 overflow-hidden">
      <div class="flex items-center gap-2 border-b border-line px-6 py-4">
        <span class="icon text-primary">credit_card</span>
        <h2 class="section-title">Kortköp med kvitto</h2>
        <span class="badge badge-neutral"><%= result.receiptMatches.length %></span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead class="border-b border-line bg-surface-low">
            <tr>
              <th class="th w-10"></th>
              <th class="th">Kvitto</th>
              <th class="th text-right">Kvittobelopp</th>
              <th class="th text-right">Dragit från kontot</th>
              <th class="th text-right">Kurs</th>
              <th class="th">Bankdatum</th>
              <th class="th">Kortköp</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% result.receiptMatches.forEach(function (m) { %>
              <tr class="hover:bg-surface-low">
                <td class="td"><input type="checkbox" name="receipts" value="<%= m.receipt.id %>|<%= m.row.date %>|<%= m.sek.toFixed(2) %>|<%= m.row.name %>" <%= m.warnings.length ? '' : 'checked' %> class="match-check rounded border-slate-300 text-primary focus:ring-primary/30" aria-label="Spara bankbeloppet på kvittot <%= m.receipt.reference || m.receipt.id %>"/></td>
                <td class="td">
                  <a href="/receipts/<%= m.receipt.id %>" target="_blank" rel="noopener" class="font-semibold hover:text-primary"><%= m.receipt.source %></a>
                  <span class="block font-mono text-xs text-ink-muted"><%= m.receipt.reference || h.date(m.receipt.received_at) %></span>
                  <% if (!m.exact) { %><span class="badge badge-neutral mt-1">Matchad på butik, datum och belopp</span><% } %>
                  <% m.warnings.forEach(function (w) { %><span class="badge badge-approved mt-1"><span class="icon icon-sm">warning</span><%= w %></span> <% }); %>
                </td>
                <td class="td whitespace-nowrap text-right tabular-nums"><%= h.money(m.receipt.amount, m.receipt.currency) %></td>
                <td class="td whitespace-nowrap text-right font-semibold tabular-nums"><%= h.money(m.sek, 'SEK') %></td>
                <td class="td whitespace-nowrap text-right tabular-nums"><%= m.rate ? String(m.rate.toFixed(4)).replace('.', ',') : '–' %></td>
                <td class="td whitespace-nowrap"><%= m.row.date %></td>
                <td class="td font-mono text-xs text-ink-muted"><%= m.row.name %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-low px-6 py-4">
        <p class="text-sm text-ink-muted">Beloppet i SEK och bankdatumet sparas på kvittot och följer med i CSV-exporten.</p>
        <button type="submit" class="btn btn-success"><span class="icon">credit_score</span>Spara på valda kvitton</button>
      </div>
    </div>
  <% } %>
  <% if (result.payouts.length) { %>
    <div class="card mb-8 overflow-hidden">
      <div class="flex items-center gap-2 border-b border-line px-6 py-4">
        <span class="icon text-emerald-600">storefront</span>
        <h2 class="section-title">Shopify-utbetalningar på kontoutdraget</h2>
        <span class="badge badge-neutral"><%= result.payouts.length %></span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead class="border-b border-line bg-surface-low">
            <tr>
              <th class="th w-10"></th>
              <th class="th">Utbetalning</th>
              <th class="th text-right">Netto enligt Shopify</th>
              <th class="th text-right">Inbetalt</th>
              <th class="th">Bankdatum</th>
              <th class="th">Avsändare på inbetalningen</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% result.payouts.forEach(function (m) { %>
              <tr class="hover:bg-surface-low">
                <td class="td"><input type="checkbox" name="payouts" value="<%= m.payout.id %>|<%= m.row.date %>" <%= m.exact ? 'checked' : '' %> class="match-check rounded border-slate-300 text-primary focus:ring-primary/30" aria-label="Bocka av utbetalning <%= m.payout.id %>"/></td>
                <td class="td"><a href="/shopify" class="font-semibold hover:text-primary">Shopify <%= h.date(m.payout.issued_at) %></a><span class="block font-mono text-xs text-ink-muted">#<%= m.payout.id %></span><% if (!m.exact) { %><span class="badge badge-approved mt-1"><span class="icon icon-sm">warning</span>Matchad bara på belopp</span><% } %></td>
                <td class="td whitespace-nowrap text-right tabular-nums"><%= h.money(m.payout.net, m.payout.currency) %></td>
                <td class="td whitespace-nowrap text-right font-semibold tabular-nums"><%= h.money(m.row.amount, m.row.currency) %></td>
                <td class="td whitespace-nowrap"><%= m.row.date %></td>
                <td class="td text-xs text-ink-muted"><%= m.row.name %><span class="block font-mono"><%= m.row.message %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% if (!result.toMark.length) { %>
        <div class="flex justify-end border-t border-line bg-surface-low px-6 py-4">
          <button type="submit" class="btn btn-success"><span class="icon">task_alt</span>Bocka av valda</button>
        </div>
      <% } %>
    </div>
  <% } %>

  <% if (result.toMark.length) { %>
    <div class="card mb-8 overflow-hidden">
      <div class="flex items-center gap-2 border-b border-line px-6 py-4">
        <span class="icon text-emerald-600">check_circle</span>
        <h2 class="section-title">Matchade betalningar</h2>
        <span class="badge badge-neutral"><%= result.toMark.length %></span>
      </div>
      <div class="overflow-x-auto">
        <table class="w-full border-collapse">
          <thead class="border-b border-line bg-surface-low">
            <tr>
              <th class="th w-10"><input type="checkbox" id="match-all" checked class="rounded border-slate-300 text-primary focus:ring-primary/30" aria-label="Markera alla"/></th>
              <th class="th">Faktura</th>
              <th class="th text-right">Fakturabelopp</th>
              <th class="th text-right">Betalt</th>
              <th class="th">Betaldatum</th>
              <th class="th">Meddelande på betalningen</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% result.toMark.forEach(function (m) { %>
              <tr class="hover:bg-surface-low">
                <td class="td"><input type="checkbox" name="matches" value="<%= m.invoice.id %>|<%= m.row.date %>" <%= m.risky ? '' : 'checked' %> class="match-check rounded border-slate-300 text-primary focus:ring-primary/30" aria-label="Bocka av <%= m.invoice.invoice_number %>"/></td>
                <td class="td">
                  <a href="/invoices/<%= m.invoice.id %>" target="_blank" rel="noopener" class="font-semibold hover:text-primary"><%= m.invoice.vendor_name %></a>
                  <span class="block font-mono text-xs text-ink-muted"><%= m.invoice.invoice_number %></span>
                  <% m.warnings.forEach(function (w) { %><span class="badge badge-approved mt-1"><span class="icon icon-sm">warning</span><%= w %></span> <% }); %>
                </td>
                <td class="td whitespace-nowrap text-right tabular-nums"><%= h.money(m.invoice.amount, m.invoice.currency) %></td>
                <td class="td whitespace-nowrap text-right font-semibold tabular-nums"><%= h.money(Math.abs(m.row.amount), m.row.currency) %></td>
                <td class="td whitespace-nowrap"><%= m.row.date %></td>
                <td class="td text-xs text-ink-muted"><%= m.row.name %><span class="block font-mono"><%= m.row.message %></span></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-low px-6 py-4">
        <p class="text-sm text-ink-muted">Betalningar i SEK för fakturor i EUR jämförs inte på belopp – kontrollera dem vid behov.</p>
        <button type="submit" class="btn btn-success"><span class="icon">paid</span>Markera valda som betalda</button>
      </div>
    </div>
    <script>
      document.getElementById('match-all').addEventListener('change', function () {
        var checked = this.checked;
        document.querySelectorAll('.match-check').forEach(function (c) { c.checked = checked; });
      });
    </script>
  <% } else if (!result.payouts.length && !result.receiptMatches.length) { %>
    <div class="card mb-8 px-6 py-10 text-center">
      <span class="icon icon-xl mb-3 block text-emerald-600/70">verified</span>
      <p class="font-display font-bold">Inget nytt att bocka av</p>
      <p class="mt-1 text-sm text-ink-muted">Alla betalningar i filen som hör till en faktura är redan markerade som betalda.</p>
    </div>
  <% } %>
  </form>

  <% if (result.alreadyPaid.length) { %>
    <details class="card mb-8 overflow-hidden">
      <summary class="flex cursor-pointer select-none items-center gap-2 px-6 py-4 hover:bg-surface-low">
        <span class="icon text-ink-muted">done_all</span>
        <span class="section-title">Redan markerade som betalda</span>
        <span class="badge badge-neutral"><%= result.alreadyPaid.length %></span>
      </summary>
      <ul class="divide-y divide-line border-t border-line text-sm">
        <% result.alreadyPaid.forEach(function (m) { %>
          <li class="flex flex-wrap items-center justify-between gap-2 px-6 py-2.5">
            <a href="/invoices/<%= m.invoice.id %>" class="hover:text-primary"><span class="font-semibold"><%= m.invoice.vendor_name %></span> <span class="font-mono text-xs text-ink-muted"><%= m.invoice.invoice_number %></span></a>
            <span class="tabular-nums text-ink-muted"><%= m.row.date %> · <%= h.money(Math.abs(m.row.amount), m.row.currency) %></span>
          </li>
        <% }); %>
      </ul>
    </details>
  <% } %>

  <% if (result.cardsWithoutReceipt.length) { %>
    <details class="card mb-8 overflow-hidden" open>
      <summary class="flex cursor-pointer select-none items-center gap-2 px-6 py-4 hover:bg-surface-low">
        <span class="icon text-amber-600">receipt_long</span>
        <span class="section-title">Kortköp utan kvitto i AFORT</span>
        <span class="badge badge-neutral"><%= result.cardsWithoutReceipt.length %></span>
      </summary>
      <div class="overflow-x-auto border-t border-line">
        <table class="w-full border-collapse">
          <thead class="border-b border-line bg-surface-low">
            <tr><th class="th">Bankdatum</th><th class="th">Kortköp</th><th class="th text-right">Belopp</th><th class="th"></th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% result.cardsWithoutReceipt.forEach(function (u) { %>
              <tr>
                <td class="td whitespace-nowrap text-ink-muted"><%= u.date %></td>
                <td class="td font-mono text-xs"><%= u.name %></td>
                <td class="td whitespace-nowrap text-right tabular-nums"><%= h.money(Math.abs(u.amount), u.currency) %></td>
                <td class="td text-xs text-ink-muted"><%= u.googleAds ? 'Google Ads – dras löpande, bokförs mot månadsfakturan' : '' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="border-t border-line px-6 py-3 text-xs text-ink-muted">Kvittot har inte kommit in, eller kommer från en avsändare som inte hämtas. Lägg till avsändaren under Inställningar eller ladda upp kvittot under Kvitton. Reserverade köp tas med när de är bokförda.</p>
    </details>
  <% } %>

  <% if (result.unmatched.length) { %>
    <details class="card overflow-hidden">
      <summary class="flex cursor-pointer select-none items-center gap-2 px-6 py-4 hover:bg-surface-low">
        <span class="icon text-amber-600">help</span>
        <span class="section-title">Betalningar utan matchande faktura</span>
        <span class="badge badge-neutral"><%= result.unmatched.length %></span>
      </summary>
      <div class="overflow-x-auto border-t border-line">
        <table class="w-full border-collapse">
          <thead class="border-b border-line bg-surface-low">
            <tr><th class="th">Datum</th><th class="th">Mottagare</th><th class="th text-right">Belopp</th><th class="th">Meddelande</th></tr>
          </thead>
          <tbody class="divide-y divide-line">
            <% result.unmatched.forEach(function (u) { %>
              <tr>
                <td class="td whitespace-nowrap text-ink-muted"><%= u.date %></td>
                <td class="td"><%= u.name || '–' %></td>
                <td class="td whitespace-nowrap text-right tabular-nums"><%= h.money(Math.abs(u.amount), u.currency) %></td>
                <td class="td font-mono text-xs text-ink-muted"><%= u.message || '–' %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="border-t border-line px-6 py-3 text-xs text-ink-muted">Skatter, avgifter och betalningar till leverantörer som inte hämtas in hamnar här. Saknas en faktura? Lägg till avsändaren under Inställningar.</p>
    </details>
  <% } %>
<% } else { %>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
    <div class="card p-5"><span class="badge badge-new mb-3">1</span><p class="font-display font-bold">Exportera från Nordea</p><p class="mt-1 text-sm text-ink-muted">Hämta kontoutdraget för perioden som en CSV-fil.</p></div>
    <div class="card p-5"><span class="badge badge-new mb-3">2</span><p class="font-display font-bold">Ladda upp här</p><p class="mt-1 text-sm text-ink-muted">AFORT letar upp fakturanumret i varje betalnings meddelande.</p></div>
    <div class="card p-5"><span class="badge badge-new mb-3">3</span><p class="font-display font-bold">Granska och bekräfta</p><p class="mt-1 text-sm text-ink-muted">Du ser alla träffar innan något ändras, och kan bocka ur det som inte stämmer.</p></div>
  </div>
<% } %>
<%- include('partials/shell-bottom') %>
