<%- include('partials/head', { title: 'Shopify' }) %>
<%- include('partials/shell-top') %>
<%
  var shopifyStatus = { SCHEDULED: 'Planerad', IN_TRANSIT: 'På väg', PAID: 'Utbetald', FAILED: 'Misslyckad', CANCELED: 'Avbruten' };
  var localStatus = { new: ['Ej avstämd', 'badge-new'], received: ['Inbetald', 'badge-approved'], booked: ['Bokförd', 'badge-paid'] };
  var lastSync = syncStatus.finishedAt ? h.date(syncStatus.finishedAt) : null;
%>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="page-title">Shopify-utbetalningar</h1>
    <p class="page-subtitle">Det Shopify Payments betalar ut till banken, med försäljning, återbetalningar och avgifter bakom varje utbetalning.</p>
  </div>
  <% if (configured) { %>
    <form method="POST" action="/shopify/sync">
      <button type="submit" class="btn btn-secondary"><span class="icon">sync</span>Hämta från Shopify</button>
    </form>
  <% } %>
</div>

<% if (!configured) { %>
  <div class="card mb-8 p-6">
    <h2 class="section-title"><span class="icon text-primary">link</span>Koppla butiken</h2>
    <p class="mt-1 text-sm text-ink-muted">Appen <span class="font-semibold">AFORT</span> finns i Shopifys Dev Dashboard och är installerad i butiken med läsrätt till Shopify Payments. Det som återstår är att ge AFORT appens inloggningsuppgifter.</p>
    <ol class="mt-5 space-y-3 text-sm">
      <li class="flex gap-3"><span class="badge badge-new">1</span><span>Öppna <a href="https://dev.shopify.com/dashboard" target="_blank" rel="noopener" class="font-semibold text-primary hover:underline">dev.shopify.com</a> → <span class="font-semibold">Apps → AFORT</span>. Under <span class="font-semibold">Credentials</span> finns Client ID och Client secret (kopieringsknappen till höger).</span></li>
      <li class="flex gap-3"><span class="badge badge-new">2</span><span>I Railway, tjänsten AFORT → <span class="font-semibold">Variables</span>, lägg till det som saknas nedan och tryck <span class="font-semibold">Deploy</span>.</span></li>
    </ol>
    <ul class="mt-4 space-y-1 rounded-lg border border-line bg-surface-low px-4 py-3 font-mono text-xs">
      <li class="<%= missing.includes('SHOPIFY_STORE_DOMAIN') ? 'text-ink' : 'text-emerald-700' %>"><span class="icon icon-sm align-middle"><%= missing.includes('SHOPIFY_STORE_DOMAIN') ? 'radio_button_unchecked' : 'check_circle' %></span> SHOPIFY_STORE_DOMAIN = viwrsi-jk.myshopify.com</li>
      <li class="<%= missing.includes('SHOPIFY_CLIENT_ID') ? 'text-ink' : 'text-emerald-700' %>"><span class="icon icon-sm align-middle"><%= missing.includes('SHOPIFY_CLIENT_ID') ? 'radio_button_unchecked' : 'check_circle' %></span> SHOPIFY_CLIENT_ID = Client ID från appen AFORT</li>
      <li class="<%= missing.includes('SHOPIFY_CLIENT_SECRET') ? 'text-ink' : 'text-emerald-700' %>"><span class="icon icon-sm align-middle"><%= missing.includes('SHOPIFY_CLIENT_SECRET') ? 'radio_button_unchecked' : 'check_circle' %></span> SHOPIFY_CLIENT_SECRET = Client secret från appen AFORT</li>
    </ul>
    <p class="hint">Appen kan bara läsa utbetalningar och kontouppgifter för Shopify Payments – inget i butiken kan ändras. AFORT hämtar själv en ny åtkomst varje dygn.</p>
  </div>
<% } %>

<% if (pending && (pending.count || pending.balance)) { %>
  <details class="card mb-8 overflow-hidden">
    <summary class="flex cursor-pointer select-none flex-wrap items-center gap-x-6 gap-y-2 px-6 py-5 hover:bg-surface-low">
      <span class="flex items-center gap-2"><span class="icon text-amber-600">schedule</span><span class="section-title">Väntar på utbetalning</span></span>
      <span class="font-display text-2xl font-extrabold tabular-nums"><%= h.money(pending.net, pending.currency) %></span>
      <span class="text-sm text-ink-muted"><%= pending.count %> transaktioner · brutto <%= h.money(pending.gross, null) %><% if (pending.vat != null) { %> · varav moms <%= h.money(pending.vat, null) %><% } %> · avgifter −<%= h.money(pending.fees, null) %></span>
      <span class="ml-auto text-xs text-ink-faint">Uppdaterat <%= h.date(pending.updatedAt) %> · visa ordrar</span>
    </summary>
    <div class="overflow-x-auto border-t border-line">
      <table class="w-full border-collapse">
        <thead class="border-b border-line bg-surface-low">
          <tr><th class="th">Datum</th><th class="th">Typ</th><th class="th">Order</th><th class="th text-right">Brutto</th><th class="th text-right">Moms <%= vatRate %> %</th><th class="th text-right">Avgift</th><th class="th text-right">Netto</th></tr>
        </thead>
        <tbody class="divide-y divide-line">
          <% pending.transactions.forEach(function (t) { %>
            <tr>
              <td class="td whitespace-nowrap text-ink-muted"><%= t.date %></td>
              <td class="td"><%= t.type %></td>
              <td class="td font-mono text-[13px]"><%= t.order || '–' %></td>
              <td class="td whitespace-nowrap text-right tabular-nums"><%= h.money(t.gross, null) %></td>
              <td class="td whitespace-nowrap text-right tabular-nums text-ink-muted"><%= t.vat != null ? h.money(t.vat, null) : '–' %></td>
              <td class="td whitespace-nowrap text-right tabular-nums text-ink-muted"><%= h.money(t.fee, null) %></td>
              <td class="td whitespace-nowrap text-right font-semibold tabular-nums"><%= h.money(t.net, t.currency) %></td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <p class="border-t border-line bg-surface-low px-6 py-3 text-xs text-ink-muted">Pengar som Shopify håller men inte har betalat ut än. När utbetalningen sker flyttas de till en rad nedan, med underlag att ladda ner.</p>
  </details>
<% } %>

<div class="mb-8 grid grid-cols-2 gap-4 lg:grid-cols-4">
  <div class="card p-5">
    <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Utbetalningar</span>
    <div class="mt-2 font-display text-2xl font-extrabold"><%= stats.count %></div>
    <div class="mt-1 text-sm text-ink-muted"><%= lastSync ? 'Senast hämtat ' + lastSync : (configured ? 'Inte hämtat ännu' : 'Inte kopplat') %></div>
  </div>
  <div class="card p-5 <%= stats.unmatched ? 'border-amber-200 bg-amber-50/40' : '' %>">
    <span class="text-xs font-semibold uppercase tracking-wider <%= stats.unmatched ? 'text-amber-700' : 'text-ink-muted' %>">Ej avstämda mot bank</span>
    <div class="mt-2 font-display text-2xl font-extrabold <%= stats.unmatched ? 'text-amber-700' : '' %>"><%= stats.unmatched %></div>
    <div class="mt-1 text-sm text-ink-muted">Bockas av när bankutdraget laddas upp</div>
  </div>
  <div class="card p-5">
    <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Utbetalt i år</span>
    <div class="mt-2 font-display text-2xl font-extrabold"><%= h.money(stats.netThisYear, stats.currency) %></div>
    <div class="mt-1 text-sm text-ink-muted">Netto efter avgifter</div>
  </div>
  <div class="card p-5">
    <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Avgifter i år</span>
    <div class="mt-2 font-display text-2xl font-extrabold"><%= h.money(stats.feesThisYear, stats.currency) %></div>
    <div class="mt-1 text-sm text-ink-muted">Shopify Payments-avgifter</div>
  </div>
</div>

<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead class="border-b border-line bg-surface-low">
        <tr>
          <th class="th">Utbetald</th>
          <th class="th">Shopify</th>
          <th class="th text-right">Försäljning</th>
          <th class="th text-right">Återbet.</th>
          <th class="th text-right">Moms <%= vatRate %> %</th>
          <th class="th text-right">Avgifter</th>
          <th class="th text-right">Netto till bank</th>
          <th class="th">Bank</th>
          <th class="th">Status</th>
          <th class="th w-28"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% if (payouts.length === 0) { %>
          <tr>
            <td colspan="10" class="px-6 py-16 text-center">
              <span class="icon icon-xl mb-3 block text-ink-faint/60">storefront</span>
              <p class="font-display font-bold">Inga utbetalningar hämtade ännu</p>
              <p class="mx-auto mt-1 max-w-md text-sm text-ink-muted"><%= configured ? 'Klicka på ”Hämta från Shopify”. Därefter hämtas nya utbetalningar automatiskt varje morgon.' : 'Koppla butiken enligt stegen ovan.' %></p>
            </td>
          </tr>
        <% } %>
        <% payouts.forEach(function (p) { var fees = (p.charges_fee || 0) + (p.refunds_fee || 0) + (p.adjustments_fee || 0) + (p.reserved_fee || 0); var st = localStatus[p.status] || localStatus.new; var vatBase = (p.charges_gross || 0) - Math.abs(p.refunds_gross || 0); var vat = Math.round(vatBase * vatRate / (100 + vatRate) * 100) / 100; %>
          <tr class="hover:bg-surface-low">
            <td class="td whitespace-nowrap font-semibold"><%= h.date(p.issued_at) %><span class="block font-mono text-xs font-normal text-ink-faint">#<%= p.id %></span></td>
            <td class="td whitespace-nowrap text-sm <%= p.shopify_status === 'FAILED' || p.shopify_status === 'CANCELED' ? 'text-red-600' : 'text-ink-muted' %>"><%= shopifyStatus[p.shopify_status] || p.shopify_status %></td>
            <td class="td whitespace-nowrap text-right tabular-nums"><%= h.money(p.charges_gross, null) %></td>
            <td class="td whitespace-nowrap text-right tabular-nums text-ink-muted"><%= p.refunds_gross ? '−' + h.money(Math.abs(p.refunds_gross), null) : '–' %></td>
            <td class="td whitespace-nowrap text-right tabular-nums text-ink-muted"><%= h.money(vat, null) %></td>
            <td class="td whitespace-nowrap text-right tabular-nums text-ink-muted">−<%= h.money(fees, null) %></td>
            <td class="td whitespace-nowrap text-right font-semibold tabular-nums"><%= h.money(p.net, p.currency) %></td>
            <td class="td whitespace-nowrap text-sm"><%= p.bank_date ? p.bank_date : '<span class="text-ink-faint">–</span>' %></td>
            <td class="td whitespace-nowrap"><span class="badge <%= st[1] %>"><%= st[0] %></span></td>
            <td class="td whitespace-nowrap text-right">
              <a href="/shopify/<%= p.id %>/report" class="inline-flex rounded p-1 text-ink-faint hover:bg-surface-mid hover:text-primary" title="Ladda ner underlag (CSV)" aria-label="Ladda ner underlag"><span class="icon">download</span></a>
              <% if (p.status === 'booked') { %>
                <form method="POST" action="/shopify/<%= p.id %>/status" class="inline"><input type="hidden" name="status" value="<%= p.bank_date ? 'received' : 'new' %>"/><button type="submit" class="inline-flex rounded p-1 text-ink-faint hover:bg-surface-mid hover:text-primary" title="Ångra bokförd" aria-label="Ångra bokförd"><span class="icon">undo</span></button></form>
              <% } else { %>
                <form method="POST" action="/shopify/<%= p.id %>/status" class="inline"><input type="hidden" name="status" value="booked"/><button type="submit" class="inline-flex rounded p-1 text-ink-faint hover:bg-surface-mid hover:text-emerald-600" title="Markera bokförd" aria-label="Markera bokförd"><span class="icon">task_alt</span></button></form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <p class="border-t border-line bg-surface-low px-4 py-3 text-xs text-ink-muted">Underlaget per utbetalning är en CSV med varje order, återbetalning och avgift samt en sammanställning – öppnas i Excel. Försäljningen är inklusive <%= vatRate %> % moms, som räknas fram ur bruttobeloppet (utgående moms). Shopifys avgifter faktureras utan moms. ”Netto till bank” är det belopp som ska synas som inbetalning på kontoutdraget.</p>
</div>
<%- include('partials/shell-bottom') %>
