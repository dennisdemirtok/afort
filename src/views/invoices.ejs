<%- include('partials/head', { title: 'Fakturor' }) %>
<%- include('partials/shell-top') %>
<%
  var isAdmin = user.role === 'admin';
  var tabs = [
    { key: '', label: 'Alla', count: counts.all },
    { key: 'new', label: 'Nya', count: counts.new },
    { key: 'approved', label: 'Godkända', count: counts.approved },
    { key: 'exported', label: 'Exporterade', count: counts.exported },
    { key: 'paid', label: 'Betalda', count: counts.paid },
  ];
  var totals = function (list) {
    return list.length ? list.map(function (t) { return h.money(t.total, t.currency); }).join(' + ') : '0,00';
  };
%>

<div class="mb-8 flex flex-wrap items-end justify-between gap-4">
  <div>
    <h1 class="page-title">Fakturor</h1>
    <p class="page-subtitle">Hämtas automatiskt från Gmail var 15:e minut.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <button type="button" id="poll-button" class="btn btn-secondary" onclick="pollNow(this)">
      <span class="icon">sync</span><span data-label>Hämta nya nu</span>
    </button>
    <a href="/api/export/csv<%= h.filterQuery(filters) %>" class="btn btn-secondary" title="Exporterar de fakturor som visas med nuvarande filter">
      <span class="icon">download</span>Exportera CSV
    </a>
  </div>
</div>

<!-- Overview -->
<div class="mb-8 grid grid-cols-1 gap-4 sm:grid-cols-3">
  <a href="/invoices" class="card block p-5 transition hover:border-primary/40">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Att betala</span>
      <span class="icon text-primary">account_balance_wallet</span>
    </div>
    <div class="mt-2 font-display text-2xl font-extrabold"><%= stats.unpaidCount %> <span class="text-base font-semibold text-ink-muted">fakturor</span></div>
    <div class="mt-1 text-sm text-ink-muted"><%= totals(stats.unpaidTotals) %></div>
  </a>
  <a href="/invoices?overdue=1" class="card block p-5 transition <%= stats.overdueCount ? 'border-red-200 bg-red-50/40 hover:border-red-300' : 'hover:border-primary/40' %>">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wider <%= stats.overdueCount ? 'text-red-700' : 'text-ink-muted' %>">Förfallna</span>
      <span class="icon <%= stats.overdueCount ? 'text-red-600' : 'text-emerald-600' %>"><%= stats.overdueCount ? 'warning' : 'check_circle' %></span>
    </div>
    <div class="mt-2 font-display text-2xl font-extrabold <%= stats.overdueCount ? 'text-red-700' : '' %>"><%= stats.overdueCount %> <span class="text-base font-semibold <%= stats.overdueCount ? 'text-red-700/70' : 'text-ink-muted' %>">fakturor</span></div>
    <div class="mt-1 text-sm <%= stats.overdueCount ? 'text-red-700/80' : 'text-ink-muted' %>"><%= stats.overdueCount ? totals(stats.overdueTotals) : 'Inget har passerat förfallodatum' %></div>
  </a>
  <a href="/invoices?status=new" class="card block p-5 transition hover:border-primary/40">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold uppercase tracking-wider text-ink-muted">Nya att granska</span>
      <span class="icon text-primary">mark_email_unread</span>
    </div>
    <div class="mt-2 font-display text-2xl font-extrabold"><%= stats.newCount %> <span class="text-base font-semibold text-ink-muted">fakturor</span></div>
    <div class="mt-1 text-sm text-ink-muted">
      <% if (stats.missingDataCount) { %><%= stats.missingDataCount %> saknar belopp eller fakturanummer<% } else { %>Alla har belopp och fakturanummer<% } %>
    </div>
  </a>
</div>

<!-- Filters -->
<div class="mb-4 flex flex-wrap items-center gap-3">
  <div class="flex max-w-full gap-1 overflow-x-auto rounded-lg bg-surface-mid p-1" role="tablist" aria-label="Status">
    <% tabs.forEach(function (tab) { var active = (filters.status || '') === tab.key; %>
      <a href="/invoices<%= h.filterQuery(filters, { status: tab.key || undefined }) %>" class="tab <%= active ? 'tab-active' : '' %>" role="tab" aria-selected="<%= active %>">
        <%= tab.label %> <span class="ml-1 text-xs font-normal opacity-60"><%= tab.count %></span>
      </a>
    <% }); %>
  </div>

  <form method="GET" action="/invoices" class="ml-auto flex items-center gap-2">
    <% if (filters.status) { %><input type="hidden" name="status" value="<%= filters.status %>"/><% } %>
    <% if (filters.q) { %><input type="hidden" name="q" value="<%= filters.q %>"/><% } %>
    <% if (filters.overdue) { %><input type="hidden" name="overdue" value="1"/><% } %>
    <% if (filters.duplicates) { %><input type="hidden" name="duplicates" value="1"/><% } %>
    <label class="sr-only" for="vendor-filter">Leverantör</label>
    <select id="vendor-filter" name="vendor" class="input w-auto min-w-[12rem] py-2 pr-9" onchange="this.form.submit()">
      <option value="">Alla leverantörer</option>
      <% vendors.forEach(function (v) { %>
        <option value="<%= v %>" <%= filters.vendor === v ? 'selected' : '' %>><%= v %></option>
      <% }); %>
    </select>
  </form>
</div>

<% if (filters.q || filters.overdue || filters.duplicates || filters.vendor) { %>
  <div class="mb-4 flex flex-wrap items-center gap-2 text-sm">
    <span class="text-ink-muted">Filter:</span>
    <% if (filters.q) { %><a href="/invoices<%= h.filterQuery(filters, { q: undefined }) %>" class="badge badge-neutral hover:bg-slate-200">Sökning: “<%= filters.q %>” <span class="icon icon-sm">close</span></a><% } %>
    <% if (filters.vendor) { %><a href="/invoices<%= h.filterQuery(filters, { vendor: undefined }) %>" class="badge badge-neutral hover:bg-slate-200"><%= filters.vendor %> <span class="icon icon-sm">close</span></a><% } %>
    <% if (filters.overdue) { %><a href="/invoices<%= h.filterQuery(filters, { overdue: undefined }) %>" class="badge badge-overdue hover:bg-red-200">Förfallna <span class="icon icon-sm">close</span></a><% } %>
    <% if (filters.duplicates) { %><a href="/invoices<%= h.filterQuery(filters, { duplicates: undefined }) %>" class="badge badge-neutral hover:bg-slate-200">Möjliga dubbletter <span class="icon icon-sm">close</span></a><% } %>
    <a href="/invoices" class="text-xs font-semibold text-primary hover:underline">Rensa alla</a>
  </div>
<% } %>

<% if (filters.duplicates && invoices.length) { %>
  <div class="flash flash-info"><span class="icon">info</span><span>Raderna nedan är kopior av fakturor som redan finns (samma leverantör, fakturanummer och belopp) – oftast påminnelser eller vidarebefordrade mail. Originalet visas inte här och ligger kvar om du raderar dessa.</span></div>
<% } %>

<!-- Table -->
<div class="card overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead class="border-b border-line bg-surface-low">
        <tr>
          <th class="th w-10"><input type="checkbox" id="select-all" class="rounded border-slate-300 text-primary focus:ring-primary/30" aria-label="Markera alla på sidan" onchange="toggleAll(this)"/></th>
          <th class="th">Mottagen</th>
          <th class="th">Leverantör</th>
          <th class="th">Fakturanr.</th>
          <th class="th text-right">Belopp</th>
          <th class="th">Förfaller</th>
          <th class="th">Status</th>
          <th class="th w-12 text-center">PDF</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        <% if (invoices.length === 0) { %>
          <tr>
            <td colspan="8" class="px-6 py-16 text-center">
              <span class="icon icon-xl mb-3 block text-ink-faint/60">inbox</span>
              <p class="font-display font-bold"><%= counts.all === 0 && !filters.q && !filters.vendor && !filters.overdue && !filters.duplicates ? 'Inga fakturor ännu' : 'Inga fakturor matchar filtret' %></p>
              <p class="mt-1 text-sm text-ink-muted"><%= counts.all === 0 ? 'Nya fakturor dyker upp här när de kommer in i Gmail.' : 'Prova att ändra status, leverantör eller sökord.' %></p>
            </td>
          </tr>
        <% } %>
        <% invoices.forEach(function (inv) { var overdue = h.isOverdue(inv); %>
          <tr class="group cursor-pointer transition-colors hover:bg-surface-low" data-href="/invoices/<%= inv.id %>">
            <td class="td"><input type="checkbox" class="inv-check rounded border-slate-300 text-primary focus:ring-primary/30" value="<%= inv.id %>" aria-label="Markera faktura <%= inv.invoice_number || '' %>" onchange="updateToolbar()"/></td>
            <td class="td whitespace-nowrap text-ink-muted"><%= h.date(inv.received_at) %></td>
            <td class="td">
              <a href="/invoices/<%= inv.id %>" class="flex items-center gap-3">
                <span class="avatar"><%= h.initials(inv.vendor_name) %></span>
                <span class="font-semibold group-hover:text-primary"><%= inv.vendor_name || 'Okänd leverantör' %></span>
              </a>
            </td>
            <td class="td whitespace-nowrap font-mono text-[13px] text-ink-muted">
              <% if (inv.invoice_number) { %><%= inv.invoice_number %><% } else { %><span class="badge badge-neutral font-sans">Saknas</span><% } %>
            </td>
            <td class="td whitespace-nowrap text-right font-semibold tabular-nums">
              <% if (inv.amount != null) { %><%= h.money(inv.amount) %> <span class="text-xs font-medium text-ink-muted"><%= inv.currency %></span><% } else { %><span class="badge badge-neutral">Saknas</span><% } %>
            </td>
            <td class="td whitespace-nowrap">
              <% if (overdue) { %>
                <span class="font-medium text-red-700"><%= inv.due_date %></span>
                <span class="badge badge-overdue ml-1"><%= h.daysOverdue(inv.due_date) %> d</span>
              <% } else { %>
                <span class="text-ink-muted"><%= inv.due_date || '–' %></span>
              <% } %>
            </td>
            <td class="td whitespace-nowrap">
              <span class="badge badge-<%= inv.status %>"><%= h.statusLabel(inv.status) %></span>
              <% if (inv.status === 'paid' && inv.paid_at) { %><span class="ml-1 text-xs text-ink-faint"><%= inv.paid_at %></span><% } %>
            </td>
            <td class="td text-center">
              <% if (inv.pdf_path) { %>
                <a href="/invoices/<%= inv.id %>/pdf" class="inline-flex rounded p-1 text-ink-faint hover:bg-surface-mid hover:text-primary" title="Ladda ner PDF" aria-label="Ladda ner PDF"><span class="icon">picture_as_pdf</span></a>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-3 border-t border-line bg-surface-low px-4 py-3 text-xs text-ink-muted">
    <span>
      <% if (total === 0) { %>0 fakturor<% } else { %>
        Visar <%= (page - 1) * pageSize + 1 %>–<%= (page - 1) * pageSize + invoices.length %> av <%= total %> fakturor
      <% } %>
    </span>
    <% if (pages > 1) { %>
      <nav class="flex items-center gap-1" aria-label="Sidor">
        <% if (page > 1) { %><a class="btn btn-secondary btn-sm" href="/invoices<%= h.filterQuery(filters, { page: page - 1 }) %>"><span class="icon icon-sm">chevron_left</span>Föregående</a><% } %>
        <span class="px-2">Sida <%= page %> av <%= pages %></span>
        <% if (page < pages) { %><a class="btn btn-secondary btn-sm" href="/invoices<%= h.filterQuery(filters, { page: page + 1 }) %>">Nästa<span class="icon icon-sm">chevron_right</span></a><% } %>
      </nav>
    <% } %>
  </div>
</div>

<!-- Bulk actions: floats at the bottom while invoices are selected -->
<div id="bulk-toolbar" class="pointer-events-none fixed inset-x-0 bottom-6 z-40 hidden justify-center px-4 lg:pl-64">
  <div class="pointer-events-auto flex max-w-full flex-wrap items-center gap-2 rounded-xl bg-ink px-4 py-3 text-white shadow-pop">
    <span class="mr-2 text-sm font-semibold"><span id="selected-count">0</span> markerade</span>
    <button type="button" onclick="bulkAction('approved')" class="btn btn-sm bg-white/10 text-white hover:bg-white/20"><span class="icon icon-sm">task_alt</span>Godkänn</button>
    <button type="button" onclick="bulkAction('paid')" class="btn btn-sm bg-white/10 text-white hover:bg-white/20"><span class="icon icon-sm">paid</span>Markera betalda</button>
    <button type="button" onclick="bulkAction('new')" class="btn btn-sm bg-white/10 text-white hover:bg-white/20"><span class="icon icon-sm">undo</span>Återställ till ny</button>
    <button type="button" onclick="downloadZip()" class="btn btn-sm bg-white/10 text-white hover:bg-white/20"><span class="icon icon-sm">folder_zip</span>Ladda ner PDF:er</button>
    <% if (isAdmin) { %>
      <button type="button" onclick="bulkAction('delete')" class="btn btn-sm bg-red-500/90 text-white hover:bg-red-500"><span class="icon icon-sm">delete</span>Radera</button>
    <% } %>
    <button type="button" onclick="clearSelection()" class="btn btn-sm text-white/70 hover:text-white" aria-label="Avmarkera alla"><span class="icon icon-sm">close</span></button>
  </div>
</div>

<form id="zip-form" method="POST" action="/invoices/download-zip" class="hidden"></form>

<script>
  // Whole row opens the invoice, except when clicking a control inside it
  document.querySelectorAll('tr[data-href]').forEach(function (row) {
    row.addEventListener('click', function (e) {
      if (e.target.closest('a, button, input, label')) return;
      window.location.href = row.dataset.href;
    });
  });

  function getSelectedIds() {
    return Array.from(document.querySelectorAll('.inv-check:checked')).map(function (cb) { return cb.value; });
  }

  function updateToolbar() {
    var ids = getSelectedIds();
    var all = document.querySelectorAll('.inv-check');
    var toolbar = document.getElementById('bulk-toolbar');
    toolbar.classList.toggle('hidden', ids.length === 0);
    toolbar.classList.toggle('flex', ids.length > 0);
    document.getElementById('selected-count').textContent = ids.length;
    var master = document.getElementById('select-all');
    master.checked = ids.length > 0 && ids.length === all.length;
    master.indeterminate = ids.length > 0 && ids.length < all.length;
  }

  function toggleAll(master) {
    document.querySelectorAll('.inv-check').forEach(function (cb) { cb.checked = master.checked; });
    updateToolbar();
  }

  function clearSelection() {
    document.querySelectorAll('.inv-check').forEach(function (cb) { cb.checked = false; });
    updateToolbar();
  }

  function bulkAction(action) {
    var ids = getSelectedIds();
    if (!ids.length) return;
    var n = ids.length + (ids.length === 1 ? ' faktura' : ' fakturor');
    var question = {
      delete: 'Radera ' + n + '? De hämtas inte in igen från Gmail.',
      paid: 'Markera ' + n + ' som betalda?',
      approved: 'Godkänna ' + n + '?',
      new: 'Återställa ' + n + ' till status Ny?'
    }[action];
    if (!confirm(question)) return;

    fetch('/api/invoices/bulk', {
      method: 'POST',
      credentials: 'same-origin',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ ids: ids, action: action })
    }).then(function (res) {
      if (res.ok) return window.location.reload();
      return res.json().then(function (body) { alert(body.error || 'Något gick fel. Försök igen.'); });
    }).catch(function () { alert('Kunde inte nå servern. Försök igen.'); });
  }

  function downloadZip() {
    var form = document.getElementById('zip-form');
    form.innerHTML = '';
    getSelectedIds().forEach(function (id) {
      var input = document.createElement('input');
      input.type = 'hidden'; input.name = 'ids'; input.value = id;
      form.appendChild(input);
    });
    form.submit();
  }

  function pollNow(button) {
    var label = button.querySelector('[data-label]');
    button.disabled = true;
    button.querySelector('.icon').classList.add('animate-spin');
    label.textContent = 'Hämtar…';
    fetch('/api/trigger-poll', { method: 'POST', credentials: 'same-origin' })
      .then(function (res) { return res.json().then(function (body) { return { ok: res.ok, body: body }; }); })
      .then(function (r) {
        if (!r.ok) throw new Error(r.body.error || 'Hämtningen misslyckades');
        var n = r.body.processed || 0;
        window.location.href = '/invoices?ok=' + encodeURIComponent(n ? n + (n === 1 ? ' ny faktura hämtad.' : ' nya fakturor hämtade.') : 'Inga nya fakturor i Gmail just nu.');
      })
      .catch(function (err) {
        button.disabled = false;
        button.querySelector('.icon').classList.remove('animate-spin');
        label.textContent = 'Hämta nya nu';
        alert(err.message);
      });
  }
</script>
<%- include('partials/shell-bottom') %>
