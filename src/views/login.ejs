<%- include('partials/head', { title: 'Logga in' }) %>
<body class="flex min-h-screen items-center justify-center px-4 py-12">
  <main class="w-full max-w-[420px]">
    <div class="mb-8 flex items-center justify-center gap-3">
      <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-primary font-display text-xl font-extrabold text-white shadow-lg shadow-primary/30">A</span>
      <span class="flex flex-col leading-tight">
        <span class="font-display text-2xl font-extrabold tracking-tight">AFORT</span>
        <span class="text-[10px] font-bold uppercase tracking-widest text-ink-faint">Faktura-automat</span>
      </span>
    </div>

    <div class="card p-8">
      <h1 class="text-xl font-extrabold tracking-tight">Logga in</h1>
      <p class="mb-6 mt-1 text-sm text-ink-muted">Se, ladda ner och bocka av leverantörsfakturor.</p>

      <% if (error) { %>
        <div class="flash flash-err mb-5" role="alert"><span class="icon">error</span><span>Fel e-post eller lösenord. Försök igen.</span></div>
      <% } %>

      <form method="POST" action="/login" class="space-y-4">
        <input type="hidden" name="next" value="<%= next %>"/>
        <div>
          <label class="label" for="email">E-post</label>
          <input class="input py-3" id="email" name="email" type="email" required autofocus autocomplete="username"/>
        </div>
        <div>
          <label class="label" for="password">Lösenord</label>
          <input class="input py-3" id="password" name="password" type="password" required autocomplete="current-password"/>
        </div>
        <button class="btn btn-primary w-full py-3" type="submit">Logga in<span class="icon">arrow_forward</span></button>
      </form>
    </div>

    <p class="mt-6 text-center text-xs text-ink-faint">Glömt lösenordet? Be en administratör skapa ett nytt under Inställningar.</p>
  </main>
</body>
</html>
