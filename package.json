{
  "name": "afort",
  "version": "1.0.0",
  "description": "Invoice Processor – Gmail to Nordea pain.001",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && npm run build:css && npm run build:vendor && cp -r src/views dist/views",
    "build:css": "tailwindcss -i src/styles/app.css -o dist/public/css/app.css --minify",
    "build:vendor": "mkdir -p dist/public/vendor/pdfjs && cp node_modules/pdfjs-dist/build/pdf.min.mjs node_modules/pdfjs-dist/build/pdf.worker.min.mjs dist/public/vendor/pdfjs/",
    "start": "node dist/index.js",
    "dev": "npm run dev:css && npm run dev:vendor && tsx watch src/index.ts",
    "dev:css": "tailwindcss -i src/styles/app.css -o src/public/css/app.css",
    "dev:vendor": "mkdir -p src/public/vendor/pdfjs && cp node_modules/pdfjs-dist/build/pdf.min.mjs node_modules/pdfjs-dist/build/pdf.worker.min.mjs src/public/vendor/pdfjs/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^144.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "pdf-parse": "^1.1.0",
    "pdfjs-dist": "^6.3.289",
    "uuid": "^11.1.0",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@types/archiver": "^6.0.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
